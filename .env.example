# Copy to .env for local development (never commit .env).

# Mapbox *public* token (pk.…): used server-side for Directions/Geocoding and
# sent to the browser for the map. Create one at https://account.mapbox.com/
MAPBOX_TOKEN=pk.your-public-token

# Local dev: enables DEBUG and a throwaway secret key.
DJANGO_DEBUG=1
# Production: DJANGO_SECRET_KEY=<long random string>

# Optional overrides
# MAP_STYLE=mapbox://styles/mapbox/light-v11
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
